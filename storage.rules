rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['rmonty98@gmail.com', 'aubren@mcxs.us']
      );
    }

    match /order-notes/{fileName} {
      allow read: if isAdmin();
      allow create: if request.auth != null
        && request.resource != null
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if isAdmin();
    }

    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /about/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /swatches/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /store/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
