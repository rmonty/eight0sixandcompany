rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email in ['rmonty98@gmail.com', 'aubren@mcxs.us']
      );
    }

    function isString(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function isOptionalString(value, maxLen) {
      return !(value is string) || value.size() <= maxLen;
    }

    function isNumber(value) {
      return value is int || value is float;
    }

    function hasOnlyKeys(data, allowed) {
      return data.keys().hasOnly(allowed);
    }

    function validChatCreate() {
      return hasOnlyKeys(request.resource.data, [
          'visitorName',
          'visitorEmail',
          'visitorToken',
          'status',
          'createdAt',
          'updatedAt',
          'lastMessage',
          'lastMessageAt',
          'unreadAdmin',
          'unreadVisitor'
        ])
        && isString(request.resource.data.visitorName, 120)
        && isString(request.resource.data.visitorEmail, 160)
        && isString(request.resource.data.visitorToken, 80)
        && request.resource.data.status == 'active'
        && isNumber(request.resource.data.createdAt)
        && isNumber(request.resource.data.updatedAt)
        && isString(request.resource.data.lastMessage, 240)
        && isNumber(request.resource.data.lastMessageAt)
        && request.resource.data.unreadAdmin == 0
        && request.resource.data.unreadVisitor == 0;
    }

    function validVisitorChatUpdate() {
      return !isSignedIn()
        && request.resource.data.visitorToken == resource.data.visitorToken
        && request.resource.data.visitorName == resource.data.visitorName
        && request.resource.data.visitorEmail == resource.data.visitorEmail
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.status == 'active'
        && resource.data.status == 'active'
        && isString(request.resource.data.lastMessage, 240)
        && isNumber(request.resource.data.lastMessageAt)
        && isNumber(request.resource.data.updatedAt)
        && request.resource.data.unreadVisitor == resource.data.unreadVisitor
        && request.resource.data.unreadAdmin == resource.data.unreadAdmin + 1;
    }

    function validChatMessageBase() {
      return hasOnlyKeys(request.resource.data, ['sender', 'text', 'createdAt', 'visitorToken'])
        && isString(request.resource.data.text, 3000)
        && isNumber(request.resource.data.createdAt)
        && isString(request.resource.data.visitorToken, 80);
    }

    function validVisitorMessage(chatId) {
      return request.auth == null
        && request.resource.data.sender == 'visitor'
        && validChatMessageBase()
        && request.resource.data.visitorToken == get(/databases/$(database)/documents/chats/$(chatId)).data.visitorToken;
    }

    function validAdminMessage(chatId) {
      return isAdmin()
        && request.resource.data.sender == 'admin'
        && validChatMessageBase()
        && request.resource.data.visitorToken == get(/databases/$(database)/documents/chats/$(chatId)).data.visitorToken;
    }

    function validSitePresenceWrite() {
      return hasOnlyKeys(request.resource.data, ['online', 'lastSeen', 'path', 'ua'])
        && request.resource.data.online is bool
        && isNumber(request.resource.data.lastSeen)
        && isString(request.resource.data.path, 200)
        && isString(request.resource.data.ua, 240);
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /gallery/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/store {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/notion {
      // enabled flag + Notion database ID only — the API key itself lives in
      // Secret Manager (NOTION_API_KEY), never in Firestore.
      allow read, write: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /giftCards/{giftCardId} {
      // Balance lookups and redemptions go through secure callables.
      allow read, write: if isAdmin();
    }

    match /orders/{orderId} {
      // Orders are created via secure callable function only.
      allow create: if false;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /userCarts/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // ── Live Chat ──
    match /presence/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /chats/{chatId} {
      allow create: if validChatCreate();
      allow read, list: if isAdmin();
      allow update: if isAdmin() || validVisitorChatUpdate();
      allow list: if isAdmin();
    }

    match /chats/{chatId}/messages/{messageId} {
      allow create: if validVisitorMessage(chatId) || validAdminMessage(chatId);
      allow read, list: if true;
    }

    match /sitePresence/{sessionId} {
      allow create, update: if validSitePresenceWrite();
      allow delete: if true;
      allow read, list: if isAdmin();
    }

    match /securityRateLimits/{docId} {
      allow read, write: if false;
    }
  }
}
